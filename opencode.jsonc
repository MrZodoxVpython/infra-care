{
  "$schema": "https://opencode.ai/config.json",

  // Tool todo untuk pekerjaan multi-langkah.
  "experimental": {
    "todo": true,
  },

  "mcp": {
    "servers": {
      // Browser automation untuk verifikasi UI, screenshot, dan uji alur.
      // Jalankan sekali: npx playwright install chromium
      "playwright": {
        "type": "local",
        "command": [
          "bunx",
          "@playwright/mcp",
          "--headless",
          "--isolated",
          "--browser",
          "chromium",
        ],
        "timeout": 120000,
      },

      // Opsional: inspeksi database read-only. Aktifkan hanya bila perlu.
      // Jangan menaruh connection string di file ini; pakai environment variable.
      // "postgres": {
      //   "type": "local",
      //   "command": [
      //     "npx",
      //     "-y",
      //     "@modelcontextprotocol/server-postgres",
      //     "{env:DATABASE_URL}",
      //   ],
      //   "timeout": 30000,
      // },
    },
  },
}
